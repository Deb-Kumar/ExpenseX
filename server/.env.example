# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your Atlas connection string:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ExpenseX?retryWrites=true&w=majority
MONGO_URI=

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret Key (used for signing session tokens)
JWT_SECRET=expensex_super_secret_jwt_dev_key_2026

# Google OAuth Credentials (for Stage 2 Authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Nodemailer SMTP Configuration (for OTP Email Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="ExpenseX Security" <noreply@expensex.app>
